# Generated analysis outputs, private caches, and local scratch files.
/output/
/logs/
/tmp*/
/Rplots.pdf
/.env
.Rhistory
.RData
.Rproj.user/
__pycache__/

# External sources and rebuildable exposure assets.
/data/raw/
/data/cache/
/data/release/
/data/processed/*
!/data/processed/community/
